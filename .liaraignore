# Liara deploy ignore
# نکته: لیارا اگر این فایل باشد، به‌جای .gitignore از همین استفاده می‌کند.
# فایل .env عمداً اینجا لیست نشده تا هنگام deploy آپلود شود و متغیرها خوانده شوند.

# کش و محیط‌های پایتون
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# ابزارها و سیستم
.git/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# دیتابیس محلی را آپلود نکن تا دیتابیس روی سرور بازنویسی نشود
news.db
*.db
*.sqlite3
# فایل‌های جانبی WAL هم نباید آپلود شوند
*-wal
*-shm
