# --- Database ---
DATABASE_URL=sqlite:///news.db

# --- AI Rewrite ---
GAPGPT_API_KEY=YOUR_GAPGPT_KEY
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-4o-mini

# --- Bale ---
BALE_BOT_TOKEN=YOUR_BALE_BOT_TOKEN
BALE_CHANNEL_ID=@your_bale_channel

# --- Rubika ---
RUBIKA_TOKEN=YOUR_RUBIKA_TOKEN
RUBIKA_CHAT_ID=@your_rubika_channel

# --- Source toggles ---
SOURCE_TASNIM_ENABLED=true
SOURCE_ISNA_ENABLED=false
SOURCE_FARS_ENABLED=false

# --- Dashboard (Monitoring Layer) ---
# اعتبار ورود به داشبورد مانیتورینگ (حتماً در محیط واقعی تغییر دهید)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me
# کلید امضای کوکی Session (یک رشته‌ی تصادفی و طولانی قرار دهید)
DASHBOARD_SECRET_KEY=please-generate-a-long-random-secret
# فعال/غیرفعال کردن داشبورد در کنار Scheduler (پیش‌فرض: true)
DASHBOARD_ENABLED=true
# پورت وب داشبورد (Liara معمولاً 3000)
PORT=3000